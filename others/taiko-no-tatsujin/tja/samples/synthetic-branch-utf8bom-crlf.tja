TITLE:Synthetic Branch Test
SUBTITLE:--hand-written for vsrg-format-docs (CC0)
BPM:120
WAVE:synthetic.ogg
OFFSET:-1.000
DEMOSTART:0
GENRE:Original
SCOREMODE:1
MAKER:vsrg-format-docs

COURSE:Oni
LEVEL:8
BALLOON:5,7,9,12
SCOREINIT:1000
SCOREDIFF:200

#START
// measure 1-2: plain notes with a Go-Go section
1020,
#GOGOSTART
3040,
#GOGOEND
// mid-measure tempo change (120 -> 150) and a delay
10
#BPMCHANGE 150
20,
#DELAY 0.5
1111,
#SECTION
#BARLINEOFF
#SCROLL 2
1212,
#SCROLL 0.5
1212,
#SCROLL 1
#BARLINEON
#MEASURE 3/4
111,
#MEASURE 4/4
// branch on accuracy: Advanced >= 60%, Master >= 90%
#BRANCHSTART p,60,90
#N
1000100010001000,
7008000050008000,
#E
1010101010101010,
7008000050008000,
#M
1111111111111111,
7008000050008000,
#BRANCHEND
#SECTION
// branch on roll hits: Advanced >= 10, Master >= 20
#BRANCHSTART r,10,20
#N
5008000050008000,
#E
5008000060008000,
#M
6008000060008000,
#BRANCHEND
#LEVELHOLD
9008,
1,
#END

COURSE:Easy
LEVEL:3
BALLOON:5

#START
1000100010001000,
1000100010001000,
7008,
#END
