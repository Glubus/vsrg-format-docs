		{ "bar": 116, "beat": 1, "y": 2, "type": "FloatingText", "rooms": [4], "id": 114, "text": "「魔/法/は/ひ/つ/要/だ/った？\nこ/わ/た/も/の/全/部/も/と/ど/お/り/に/す/る\nこ/と/が\nす/くい/に/は/な/ら/ない/よ。」\n", "times": "", "textPosition": [4.825, 9.825], "size": 8, "angle": 0, "mode": "HideAbruptly", "showChildren": true, "color": "0000008C", "outlineColor": "0000008C", "anchor": "MiddleLeft", "fadeOutRate": 3.5, "narrate": false, "narrationCategory": "Subtitles" },
		{ "bar": 116, "beat": 1, "y": 1, "type": "FloatingText", "rooms": [4], "id": 116, "text": "「魔/法/は/ひ/つ/要/だ/った？\nこ/わ/た/も/の/全/部/も/と/ど/お/り/に/す/る\nこ/と/が\nす/くい/に/は/な/ら/ない/よ。」\n", "times": "", "textPosition": [5, 10], "size": 8, "angle": 0, "mode": "HideAbruptly", "showChildren": true, "color": "FFC585FF", "outlineColor": "B88FFF80", "anchor": "MiddleLeft", "fadeOutRate": 3.5, "narrate": false, "narrationCategory": "Subtitles" },
