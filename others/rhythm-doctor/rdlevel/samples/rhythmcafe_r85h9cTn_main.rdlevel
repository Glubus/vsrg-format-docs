		{ "bar": 75, "beat": 1, "y": 2, "type": "FloatingText", "rooms": [4], "id": 85, "text": "「魔/法/は/つ/か/え/る/の？\nま/だ/い\nつ/で/も/な/お/せ/る/も/の/を/た/い/せ/つ/に\nお/も/い/つ/づ/け/ら/れ/る/の？\n魔/法/で/直/し/た/友/情/は/ホン/モ/ノ/な/の？」", "times": "", "textPosition": [4.825, 89.825], "size": 8, "angle": 0, "mode": "HideAbruptly", "showChildren": true, "color": "0000008C", "outlineColor": "0000008C", "anchor": "MiddleLeft", "fadeOutRate": 2.5, "narrate": false, "narrationCategory": "Subtitles" },
		{ "bar": 75, "beat": 1, "y": 1, "type": "FloatingText", "rooms": [4], "id": 86, "text": "「魔/法/は/つ/か/え/る/の？\nま/だ/い\nつ/で/も/な/お/せ/る/も/の/を/た/い/せ/つ/に\nお/も/い/つ/づ/け/ら/れ/る/の？\n魔/法/で/直/し/た/友/情/は/ホン/モ/ノ/な/の？」", "times": "", "textPosition": [5, 90], "size": 8, "angle": 0, "mode": "HideAbruptly", "showChildren": true, "color": "FFC585FF", "outlineColor": "B88FFF80", "anchor": "MiddleLeft", "fadeOutRate": 2.5, "narrate": false, "narrationCategory": "Subtitles" },
		{ "bar": 75, "beat": 1, "y": 3, "type": "FloatingText", "rooms": [4], "id": 87, "text": "\"Can you really use magic?\nAre you truly able to cherish things\nthat can always be fixed?\nIs the friendship you fixed with magic even real?\"", "times": "", "textPosition": [5, 85], "size": 6, "angle": 0, "mode": "HideAbruptly", "showChildren": true, "color": "704500FF", "outlineColor": "00000000", "anchor": "MiddleLeft", "fadeOutRate": 14, "narrate": true, "narrationCategory": "Instruction" },
