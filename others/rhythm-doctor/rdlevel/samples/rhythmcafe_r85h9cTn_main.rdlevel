		{ "bar": 50, "beat": 1, "y": 2, "type": "FloatingText", "rooms": [4], "id": 42, "text": "魔/法/が/つ/え/た/の\nおー/ああ\n「あ/の/日/の/あ/の/と/き/う/し/な/ったも/の/が\nも/ど/って/く/る/の/な/ら」\nそう/思/って/飛/び/だ/し/た\nのこ/どう/をお/さ/え/て", "times": "", "textPosition": [95.125, 89.825], "size": 8, "angle": 0, "mode": "HideAbruptly", "showChildren": true, "color": "0000008C", "outlineColor": "0000008C", "anchor": "MiddleRight", "fadeOutRate": 2.5, "narrate": true, "narrationCategory": "Instruction" },
		{ "bar": 50, "beat": 1, "y": 3, "type": "FloatingText", "rooms": [4], "id": 43, "text": "I could use magic!\nOoh,/ ah...\n\"I can get back what I lost\non that day, at that time,\"\nI thought as I grasped the ancient magic\nbestowed upon me.", "times": "", "textPosition": [95, 85], "size": 6, "angle": 0, "mode": "HideAbruptly", "showChildren": true, "color": "330070FF", "outlineColor": "00000000", "anchor": "MiddleRight", "fadeOutRate": 7, "narrate": true, "narrationCategory": "Instruction" },
